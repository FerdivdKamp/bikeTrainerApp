<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>com.ergtrainer.mobile</ApplicationId>
    <ApplicationTitle>ErgTrainer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.43" />
    <Compile Include="..\Sensors\*.cs" Link="Sensors\%(Filename)%(Extension)" />
    <Compile Include="..\Sessions\*.cs" Link="Sessions\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
